# ══════════════════════════════════════════════════════════════════════════════
#  MeetingMind — Configuration
#  Copy this file to .env and fill in your values.
#  Required keys are marked [REQUIRED]. Everything else is optional.
# ══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
#  LLM — Groq  [REQUIRED]
#
#  Used for:
#    • Extracting action items, decisions, and risks from the transcript
#    • Resolving ambiguous owner names when fuzzy matching scores are low
#    • Resolving ambiguous due date phrases ("by next Friday", "end of sprint")
#
#  Free tier: https://console.groq.com
#  Model used: llama-3.3-70b-versatile (100+ tokens/sec, 32k context)
# ─────────────────────────────────────────────────────────────────────────────

GROQ_API_KEY=your_groq_api_key_here


# ─────────────────────────────────────────────────────────────────────────────
#  Transcription — Deepgram  [OPTIONAL — only needed for audio/video input]
#
#  Used for: .mp3, .mp4, .wav, .m4a files
#  Not needed for .txt, .vtt, .srt transcripts (parsed natively)
#
#  Free $200 credit: https://console.deepgram.com
#  Model used: nova-3 (transcription + speaker diarization)
# ─────────────────────────────────────────────────────────────────────────────

DEEPGRAM_API_KEY=your_deepgram_api_key_here


# ─────────────────────────────────────────────────────────────────────────────
#  GitHub Integration  [REQUIRED for task creation]
#
#  GITHUB_TOKEN  — Personal Access Token
#    Generate at: https://github.com/settings/tokens → Generate new token
#    Scopes needed: repo (full access to create issues and labels)
#
#  GITHUB_REPO   — The target repository for issue creation
#    Format: username/repo-name  (e.g. yourname/meeting-assistant-demo)
#    Create a free empty private repo to use as your demo tracker.
# ─────────────────────────────────────────────────────────────────────────────

GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=your-username/meeting-assistant-demo


# ─────────────────────────────────────────────────────────────────────────────
#  Slack Integration  [OPTIONAL — for post-meeting recap messages]
#
#  Sends a Slack message after Confirm & Execute summarising all created issues.
#
#  Setup:
#    1. Go to https://api.slack.com/apps → Create New App
#    2. Enable Incoming Webhooks
#    3. Add to Workspace → select a channel
#    4. Copy the webhook URL below
#
#  Leave blank or remove to disable Slack entirely.
# ─────────────────────────────────────────────────────────────────────────────

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ


# ─────────────────────────────────────────────────────────────────────────────
#  Storage Paths  [OPTIONAL — defaults shown]
#
#  MEETING_DB_PATH  — SQLite database for the audit log and dedup index
#  LOG_PATH         — Append-only JSONL event log (immutable source of truth)
#
#  Both are created automatically on first run.
#  Change these if you want to store data outside the project directory.
# ─────────────────────────────────────────────────────────────────────────────

MEETING_DB_PATH=data/audit.db
LOG_PATH=data/audit_log.jsonl
